# Neon PostgreSQL connection string (required for leaderboard & run storage).
# Get one from https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server port (default 8080).
PORT=8080

# Node environment — set to "production" for production builds.
# NODE_ENV=production

# Vite HMR — override when running behind an HTTPS preview proxy.
# HMR_PROTOCOL=wss
# HMR_CLIENT_PORT=443
